# ============================================================
# manual-qa 环境配置（复制为 .env 后填写）
# 设计：OpenAI 兼容双栈——默认智谱，改两行即可切 OpenAI/DeepSeek/Qwen
# ============================================================

# --- LLM 供应商（chat + embedding 用同一家，也可拆开） ---
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-zhipu-key-here
LLM_MODEL=glm-4.7

# --- Embedding 供应商（可与 LLM 不同家） ---
EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBED_API_KEY=your-zhipu-key-here
EMBED_MODEL=embedding-3

# --- 检索参数 ---
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- 向量库（Qdrant 本地模式，无需 Docker） ---
QDRANT_PATH=./data/qdrant
COLLECTION=manual_chunks
